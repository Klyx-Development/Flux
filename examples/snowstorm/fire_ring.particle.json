{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "flux:fire_ring",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 150,
        "max_particles": 220
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": 1
      },
      "minecraft:emitter_shape_disc": {
        "radius": 1.8,
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.7 + variable.particle_random_1 * 0.5"
      },
      "minecraft:particle_initial_speed": "1.2 + variable.particle_random_2 * 0.8",
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_4 * 90",
        "rotation_rate": "(variable.particle_random_3 - 0.5) * 360"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          2.2,
          0
        ],
        "linear_drag_coefficient": 1.1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.03 + 0.2 * (1 - variable.particle_age / variable.particle_lifetime)",
          "0.03 + 0.2 * (1 - variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": "#FFF3A0",
            "0.3": "#FFB02E",
            "0.7": "#E8431B",
            "1.0": "#3A1208"
          }
        }
      }
    }
